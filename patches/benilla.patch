+/// The server's normal attacker-state packet is reused for CoD bullets, but the melee animation
+/// path is intentionally bypassed. Re-enter only the shared floating-number formatter so a bullet
+/// hit has the same damage colour and wording without starting a sword swing.
+fn codcraft_damage_text(
+    mut impacts: MessageReader<crate::codcraft::CodcraftDamageText>,
+    gates: Res<DamageTextGates>,
+    mut text: MessageWriter<CombatTextSpawn>,
+) {
+    for impact in impacts.read() {
+        let Some(color) = damage_color(*gates, DamageSource::Player, true) else {
+            continue;
+        };
+        if let Some((category, body)) = melee_text(
+            impact.hit_info,
+            impact.victim_state,
+            impact.damage,
+        ) {
+            text.write(CombatTextSpawn {
+                anchor: impact.anchor,
+                text: body,
+                category,
+                color,
+            });
+        }
+    }
+}
