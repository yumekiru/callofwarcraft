+fn codcraft_bullet_impact_sounds(
+    mut events: MessageReader<crate::codcraft::CodcraftBulletImpact>,
+    mut sequence: Local<u64>,
+) {
+    let Some(path) = std::env::var_os("CODCRAFT_HIT")
+        .filter(|value| !value.is_empty())
+        .map(std::path::PathBuf::from)
+    else {
+        events.clear();
+        return;
+    };
+    for _ in events.read() {
+        *sequence = sequence.wrapping_add(1).max(1);
+        if let Err(error) = std::fs::write(&path, sequence.to_le_bytes()) {
+            warn!("CoDCraft: failed to publish native hit-alert sound: {error}");
+        }
+    }
+}
