+/// Track gate misses without allowing a single bad frame to blink a live world-space label.
+fn name_miss_expired(misses: &mut u8, seen: bool) -> bool {
+    if seen {
+        *misses = 0;
+        false
+    } else {
+        *misses = misses.saturating_add(1);
+        *misses >= NAME_MISS_GRACE_FRAMES
+    }
+}
