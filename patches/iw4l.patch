+#[cfg(test)]
+mod bridge_focus_tests {
+    use super::reset_captured_client;
+
+    #[test]
+    fn unfocused_guest_preserves_bridged_fire_and_sprint_holds() {
+        let mut client = input_iw4::ClientInput::default();
+        for command in [1, 27, 59] {
+            input_iw4::input_cmd(&mut client, command, input_iw4::SCRIPT_KEYNUM, 100, 16);
+        }
+        for frame in 0..120 {
+            reset_captured_client(&mut client, true);
+            let _ = input_iw4::sample_move(&mut client, 116 + frame * 16, 16);
+            assert!(client.kb.attack.active);
+            assert!(client.kb.sprint.active);
+            assert!(client.kb.forward.active);
+            client.kb.clear_was_pressed();
+        }
+        for command in [2, 28, 60] {
+            input_iw4::input_cmd(&mut client, command, input_iw4::SCRIPT_KEYNUM, 2100, 16);
+        }
+        assert!(!client.kb.attack.active);
+        assert!(!client.kb.sprint.active);
+        assert!(!client.kb.forward.active);
+    }
+
+    #[test]
+    fn ordinary_guest_still_releases_controls_when_unfocused() {
+        let mut client = input_iw4::ClientInput::default();
+        input_iw4::input_cmd(&mut client, 1, input_iw4::SCRIPT_KEYNUM, 100, 16);
+        reset_captured_client(&mut client, false);
+        assert!(!client.kb.attack.active);
+    }
+}
