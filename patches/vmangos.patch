-    packet->victimGuid = victim ? victim->GetObjectGuid() : ObjectGuid();
-    packet->totalXp = givenXP + restXP;
-    packet->xpType = victim ? 0 : 1; // 00-kill_xp type, 01-non_kill_xp type
-    if (victim)
-    {
-        packet->baseXp = givenXP;    // experience without rested bonus
