-    if (IsTotem() || IsTrigger() || !CanHaveTarget() || HasStaticFlag(CREATURE_STATIC_FLAG_IGNORE_COMBAT))
-        SetCreatureReactState(REACT_PASSIVE);
-    else if (HasExtraFlag(CREATURE_FLAG_EXTRA_NO_AGGRO))
