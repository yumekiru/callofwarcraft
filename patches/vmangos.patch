+bool Player::IsActionButtonDataValid(uint8 button, uint32 action, uint8 type, Player const* player)
+{
+    if (button >= MAX_ACTION_BUTTONS)
+        return false;
+
+    if (action >= MAX_ACTION_BUTTON_ACTION_VALUE)
+        return false;
+
+    switch (type)
+    {
+        case ACTION_BUTTON_SPELL:
+        {
+            SpellEntry const* spellProto = sSpellMgr.GetSpellEntry(action);
+            if (!spellProto)
+                return false;
+
+            if (player)
+            {
+                if (!player->HasSpell(spellProto->Id))
+                    return false;
+                else if (spellProto->IsPassiveSpell())
+                    return false;
+            }
+            break;
+        }
+        case ACTION_BUTTON_ITEM:
+        {
+            if (!sObjectMgr.GetItemPrototype(action))
+                return false;
+            break;
+        }
+        default:
+            break;                                          // other cases not checked at this moment
+    }
+
+    return true;
+}
