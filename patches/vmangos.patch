-    CreatureInfo const* cinfo = GetCreatureInfo();
-
-    // level
-    uint32 const minLevel = cinfo->level_min;
-    uint32 const maxLevel = cinfo->level_max;
-    uint32 const level = minLevel == maxLevel ? minLevel : urand(minLevel, maxLevel);
