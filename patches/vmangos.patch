+    {
+        // Queries should NOT be deleted by user
+        DeleteAllResults();
+    }
+    ObjectGuid GetGuid() const
+    {
+        return m_guid;
+    }
+    uint32 GetAccountId() const
+    {
+        return m_accountId;
+    }
