+
+OpcodeHandler emptyHandler;
+
+OpcodeHandler const& LookupOpcodeHandler(uint16 id)
+{
+    if (id >= NUM_MSG_TYPES)
+        return emptyHandler;
+    return handlerList.handlers[id];
+}
+
+char const* LookupOpcodeName(uint16 id)
+{
+    return LookupOpcodeHandler(id).name;
+}
