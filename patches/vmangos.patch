+float Player::GetMaxLootDistance(Unit const* pUnit) const
+{
+    // Only this player's confirmed rifle kills get remote corpse access. All other
+    // loot permission, inventory, quest and group checks remain in the normal handlers.
+    if (pUnit && pUnit->GetTypeId() == TYPEID_UNIT && !pUnit->IsAlive() &&
+        static_cast<Creature const*>(pUnit)->m_codcraftBulletLootOwner == GetObjectGuid())
+        return 100.0f;
+    float distance = GetCombatReachToTarget(pUnit, false, 0.0f, true);
+    return distance;
+}
