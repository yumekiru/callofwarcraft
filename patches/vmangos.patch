+        if (group->RemoveMember(guid, 0) <= 1)
+        {
+            // group->Disband(); already disbanded in RemoveMember
+            sObjectMgr.RemoveGroup(group);
+            delete group;
+            // removemember sets the player's group pointer to nullptr
+        }
+    }
