+std::shared_ptr<time_t> const& Creature::GetLastLeashExtensionTimePtr() const
+{
+    if (m_lastLeashExtensionTime == nullptr)
+        m_lastLeashExtensionTime = std::make_shared<time_t>(time(nullptr));
+    return m_lastLeashExtensionTime;
+}
