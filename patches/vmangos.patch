+        SetSheath(SHEATH_STATE_MELEE);
+        SetUInt32Value(UNIT_NPC_EMOTESTATE, EMOTE_ONESHOT_NONE);
+
+        if (m_creatureInfo->auras)
+            LoadDefaultAuras(m_creatureInfo->auras);
+    }
