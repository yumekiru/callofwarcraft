-        if ((lastCheckTime + 30 * MINUTE) < now)
-        {
-            if (CharacterDatabase.HasAsyncQuery())
-                continue;
-            Player::DeleteOldCharacters();
-            sObjectMgr.ReturnOrDeleteOldMails(true);
-            lastCheckTime = now;
-        }
-    }
-    CharacterDatabase.ThreadEnd();
