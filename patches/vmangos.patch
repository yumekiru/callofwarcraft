-                if (!itr->second.box_broadcast_text)
-                    if (GossipMenuItemsLocale const* no = sObjectMgr.GetGossipMenuItemsLocale(idxEntry))
-                        if (no->BoxText.size() > (size_t)locIdx && !no->BoxText[locIdx].empty())
