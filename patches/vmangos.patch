-
-//[-ZERO]    SetUInt32Value(PLAYER_FIELD_MOD_TARGET_RESISTANCE,0);
-//[-ZERO]    SetUInt32Value(PLAYER_FIELD_MOD_TARGET_PHYSICAL_RESISTANCE,0);
-#if SUPPORTED_CLIENT_BUILD > CLIENT_BUILD_1_6_1
-    for (int i = 0; i < MAX_SPELL_SCHOOL; ++i)
