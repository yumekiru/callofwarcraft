+void Creature::ToggleUnitFlagsFromStaticFlags()
+{
+    if (HasStaticFlag(CREATURE_STATIC_FLAG_IMMUNE_TO_PC))
+        SetFlag(UNIT_FIELD_FLAGS, UNIT_FLAG_IMMUNE_TO_PLAYER);
