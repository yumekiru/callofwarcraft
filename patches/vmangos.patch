-                stealthedUnit->DestroyForPlayer(this);
-
-                if (Player* i_player = stealthedUnit->ToPlayer())
-                    if (i_player->m_broadcaster)
-                        i_player->m_broadcaster->RemoveListener(this);
-
-                m_visibleGUIDs.erase(stealthedUnit->GetObjectGuid());
