-uint32 World::GetQueuedSessionPos(WorldSession* sess)
-{
-    uint32 position = 1;
-
-    for (Queue::const_iterator iter = m_QueuedSessions.begin(); iter != m_QueuedSessions.end(); ++iter, ++position)
-        if ((*iter) == sess)
