-            SetHomebindToLocation(WorldLocation(1, 1633.33f, -4439.11f, 15.7588f, 0.0f), 1637);
-        }
-    }
-
-    ObjectGuid guid = GetObjectGuid();
-
-    m_session->LogoutPlayer(false);
-    sWorld.InvalidatePlayerDataToAllClient(guid);
-
-    return true;
-}
